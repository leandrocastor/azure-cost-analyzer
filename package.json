{
  "name": "azure-cost-analyzer",
  "version": "1.0.0",
  "description": "Enterprise-grade Azure Cost Analyzer CLI and dashboard",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cli/index.js",
  "bin": {
    "cost-analyzer": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/dashboard/public',{recursive:true}); fs.copyFileSync('src/dashboard/public/index.html','dist/dashboard/public/index.html');\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@azure/arm-appservice": "latest",
    "@azure/arm-compute": "latest",
    "@azure/arm-costmanagement": "latest",
    "@azure/arm-monitor": "latest",
    "@azure/arm-network": "latest",
    "@azure/arm-sql": "latest",
    "@azure/arm-storage": "latest",
    "@azure/identity": "latest",
    "@oclif/core": "latest",
    "@oclif/plugin-help": "latest",
    "@oclif/plugin-plugins": "latest",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ora": "^8.1.1",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
